---
import NewLayout from '@layouts/NewLayout.astro';
import Navigation from '@components/Navigation.astro';
import { fetchGalleries, type Gallery, getGalleryImageUrl } from '@api/gallery';
import { fetchCategories, type Category, formatCategoryName } from "@api/category";

// Fetch gallery data from API
const galleriesResponse = await fetchGalleries();
const galleries = galleriesResponse.data;

// Fetch categories
const categoriesResponse = await fetchCategories();
const allCategories = categoriesResponse.data;

// Filter categories that have galleries (check which categories are used)
const categoryIdsWithGalleries = new Set(galleries.map(g => g.category_id).filter(Boolean));
const galleryCategories = allCategories.filter(c => categoryIdsWithGalleries.has(c.id));

// Helper to get category name for a gallery
function getCategoryName(gallery: Gallery): string {
  return gallery.category?.name?.toLowerCase() ?? 'uncategorized';
}

// Helper to get first image URL from gallery
function getFirstImageUrl(gallery: Gallery, size: 'thumbnail' | 'small' | 'large' = 'large'): string {
  if (gallery.images.length === 0) {
    return '/placeholder-gallery.jpg';
  }
  const firstImage = gallery.images[0];
  return getGalleryImageUrl(firstImage, size) || '/placeholder-gallery.jpg';
}
---

<NewLayout 
  title="GALLERY - IVOKUN BLOG"
  description="Explore IVOKUN's photo gallery - A collection of unique moments and perspectives"
>
  <Navigation />
  
  <main id="main-content">
    <section class="section">
      <div class="container">
        <div class="gallery-filters">
          <button class="filter-btn active" data-filter="all">ALL</button>
          {galleryCategories.map(category => (
            <button class="filter-btn" data-filter={formatCategoryName(category.name)}>
              {formatCategoryName(category.name, true)}
            </button>
          ))}
        </div>
        
        <div class="instagram-grid">
          {galleries.length === 0 ? (
            <div class="empty-state">
              <h2 class="empty-state-title">NO GALLERIES YET</h2>
              <p class="empty-state-text">Check back soon for new galleries.</p>
            </div>
          ) : (
            galleries.map((gallery) => (
            <article class="grid-item" data-category={getCategoryName(gallery)}>
              <a href={`/gallery/${gallery.slug}`} class="grid-item-link">
                <div class="grid-image-wrapper">
                  <img 
                    src={getFirstImageUrl(gallery, 'large')} 
                    alt={gallery.title}
                    loading="lazy"
                  />
                  
                  {gallery.images.length > 1 && (
                    <div class="multi-image-indicator" aria-label={`${gallery.images.length} images`}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="14" height="14" rx="1" ry="1"></rect>
                        <rect x="8" y="8" width="14" height="14" rx="1" ry="1"></rect>
                      </svg>
                    </div>
                  )}
                  
                  <div class="grid-hover-overlay">
                    <span class="grid-overlay-title">{gallery.title}</span>
                    <span class="grid-overlay-count">
                      {gallery.images.length} {gallery.images.length === 1 ? 'image' : 'images'}
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))
          )}
        </div>
      </div>
    </section>
  </main>
</NewLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .gallery-filters {
    display: flex;
    gap: 1rem;
    margin-bottom: 3rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: var(--color-white);
    color: var(--color-black);
    border: 3px solid var(--color-black);
    padding: 0.75rem 1.5rem;
    font-family: var(--font-sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--color-black);
    color: var(--color-white);
  }

  .filter-btn.active {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--color-blue);
  }

  /* Instagram-style Grid Layout */
  .instagram-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 2rem;
    border: 4px solid var(--color-black);
    background: var(--color-white);
  }

  .empty-state-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--color-black);
  }

  .empty-state-text {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-gray);
  }

  .grid-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-gray-light, #f5f5f5);
  }

  .grid-item-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .grid-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .grid-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .grid-item:hover .grid-image-wrapper img {
    transform: scale(1.03);
  }

  /* Multi-image indicator (top-right corner) */
  .multi-image-indicator {
    position: absolute;
    top: 8px;
    right: 8px;
    color: var(--color-white);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
    z-index: 2;
    pointer-events: none;
  }

  /* Hover overlay */
  .grid-hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    opacity: 0;
    transition: opacity 0.2s ease;
    padding: 1rem;
    text-align: center;
    pointer-events: none;
  }

  .grid-item:hover .grid-hover-overlay {
    opacity: 1;
  }

  .grid-overlay-title {
    color: var(--color-white);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
    text-transform: none;
    letter-spacing: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .grid-overlay-count {
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Tablet */
  @media (max-width: 1023px) {
    .instagram-grid {
      gap: 3px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .section {
      padding: 2rem 0;
    }

    .gallery-filters {
      margin-bottom: 2rem;
      gap: 0.5rem;
    }

    .filter-btn {
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
    }

    .instagram-grid {
      gap: 2px;
    }

    .grid-overlay-title {
      font-size: 0.85rem;
    }

    .grid-overlay-count {
      font-size: 0.65rem;
    }

    .multi-image-indicator svg {
      width: 16px;
      height: 16px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .grid-image-wrapper img,
    .grid-hover-overlay {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const gridItems = document.querySelectorAll('.grid-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all buttons
        filterBtns.forEach(b => b.classList.remove('active'));
        // Add active class to clicked button
        btn.classList.add('active');

        const filter = (btn as HTMLElement).dataset.filter;

        // Show/hide gallery items based on filter
        gridItems.forEach(item => {
          const el = item as HTMLElement;
          if (filter === 'all' || el.dataset.category === filter) {
            el.style.display = 'block';
          } else {
            el.style.display = 'none';
          }
        });
      });
    });
  });
</script>
