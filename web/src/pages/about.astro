---
import NewLayout from '@layouts/NewLayout.astro';
import Navigation from '@components/Navigation.astro';
---

<NewLayout 
  title="ABOUT - IVOKUN BLOG"
  description="Learn about Salahuddin Muhammad Iqbal - Photographer, Developer, and Digital Business Enabler"
  ogImage="https://static.ivokun.com/medium_profile_ce9db95204.jpeg"
>
  <Navigation />
  
  <main id="main-content">
    <section class="section">
      <div class="container">
        <div class="about-content">
          <div class="about-text">
            <div class="about-intro">
              <h2 class="about-title">WHO AM I?</h2>
              <p class="about-description">
                I am Salahuddin Muhammad Iqbal a.k.a Ivo, a photographer, developer, and digital business enabler.
                My work is a blend of street photography and web development, capturing the essence of urban life
                while building digital solutions that empower creativity and innovation.
              </p>
            </div>

            <div class="about-section">
              <h3 class="section-heading">PHOTOGRAPHY</h3>
              <p>
                Street photography is my passion. I capture the raw energy of urban life, 
                finding beauty in the chaos of everyday moments. My work focuses on authentic 
                human experiences and the geometric patterns that emerge from city living.
              </p>
            </div>

            <div class="about-section">
              <h3 class="section-heading">TECHNOLOGY</h3>
              <p>
                For the past two years I have been a Senior Cloud Solution Architect, leading 
                cloud transformation and platform modernization for large enterprise clients. 
                The interesting details are all behind NDAs, but it boils down to Kubernetes, 
                CI/CD, observability — and turning legacy systems into boring, reliable platforms.
              </p>
              <p>
                Beyond the day job, I build with Go, TypeScript and Effect, run a NixOS-based 
                homelab (storage, containers, zero-trust network), and tinker with self-hosted 
                AI agents. Code is just another form of art.
              </p>
            </div>

            <div class="about-section">
              <h3 class="section-heading">RECENTLY</h3>
              <ul class="recent-list">
                <li>Cloud &amp; platform architecture for enterprise transformation programs</li>
                <li>Modern web stacks — Bun + Effect + PostgreSQL, Astro frontends</li>
                <li>Self-hosting everything: NAS, monitoring, personal AI tooling</li>
                <li>Still shooting the streets whenever I can</li>
              </ul>
            </div>
          </div>

          <div class="about-visual">
            <div class="profile-card">
              <div class="profile-image">
                <img src="https://static.ivokun.com/medium_profile_ce9db95204.jpeg" alt="Salahuddin Muhammad Iqbal - Photographer and Developer" />
              </div>
              <div class="profile-info">
                <h4 class="profile-name">SALAHUDDIN MUHAMMAD IQBAL</h4>
                <p class="profile-role">PHOTOGRAPHER / DEVELOPER / DIGITAL BUSINESS ENABLER</p>
              </div>
            </div>

            <div class="contact-info">
              <h4 class="contact-title">GET IN TOUCH</h4>
              <div class="contact-links">
                <a href="mailto:im@ivokun.com" class="contact-link" target="_blank" rel="noopener">
                  EMAIL →
                </a>
                <a href="https://instagram.com/ivokun" class="contact-link" target="_blank" rel="noopener">
                  INSTAGRAM →
                </a>
                <a href="https://github.com/ivokun" class="contact-link" target="_blank" rel="noopener">
                  GITHUB →
                </a>
                <a href="https://x.com/ivokun" class="contact-link" target="_blank" rel="noopener">
                  TWITTER / X →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</NewLayout>

<style>
  .section {
    padding: 4rem 0;
  }

  .section-alt {
    background: var(--color-black);
    color: var(--color-white);
  }

  .about-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-intro {
    margin-bottom: 3rem;
  }

  .about-title {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    position: relative;
  }

  .about-title::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    width: 4rem;
    height: 4px;
    background: var(--color-blue);
  }

  .about-description {
    font-size: 1.2rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  .about-section {
    margin-bottom: 2.5rem;
  }

  .section-heading {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--color-blue);
  }

  .recent-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recent-list li {
    padding: 0.75rem 0 0.75rem 1.25rem;
    border-left: 4px solid var(--color-blue);
    margin-bottom: 0.75rem;
  }

  .about-visual {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .profile-card {
    background: var(--color-white);
    border: 4px solid var(--color-black);
    padding: 2rem;
    text-align: center;
  }

  .profile-image {
    width: 150px;
    height: 150px;
    margin: 0 auto 1rem;
    border: 4px solid var(--color-black);
    overflow: hidden;
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .profile-name {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    text-transform: none;
  }

  .profile-role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-gray);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .contact-info {
    background: var(--color-black);
    color: var(--color-white);
    padding: 2rem;
    border: 4px solid var(--color-black);
  }

  .contact-title {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--color-white);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-link {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-white);
    border-color: var(--color-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-link:hover {
    background: var(--color-blue);
    color: var(--color-white);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .stat-item {
    text-align: center;
    padding: 2rem;
    border: 4px solid var(--color-white);
  }

  .stat-number {
    font-family: var(--font-sans);
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-blue);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-white);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .section {
      padding: 2rem 0;
    }

    .about-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-title {
      font-size: 2rem;
    }

    .about-description {
      font-size: 1rem;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .stat-item {
      padding: 1.5rem;
    }

    .stat-number {
      font-size: 2rem;
    }
  }
</style>
